{
  "expo": {
    "name": "Akini POS",
    "slug": "akini-pos-inventory",
    "version": "1.0.0",
    "orientation": "landscape",
    "icon": "./assets/images/akini-icon.png",
    "scheme": "posinvmobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/akini-icon-foreground.png",
        "backgroundImage": "./assets/images/akini-icon-background.png",
        "monochromeImage": "./assets/images/akini-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.akini91.posinv_mobile"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/akini-splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow StoreMate to select product photos for offline inventory records."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7024ed89-19d3-4ff2-9a7d-0f9b0d40c22b"
      }
    },
    "owner": "akini91"
  }
}
